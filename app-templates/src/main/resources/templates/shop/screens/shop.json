{
  "id": "shop",
  "title": "Shop",
  "data": {
    "store": {
      "url": "https://fakestoreapi.com/products?limit=12",
      "cacheSeconds": 600
    }
  },
  "components": [
    {
      "type": "card",
      "spacing": 6,
      "modifier": {
        "background": "#1B7A43",
        "cornerRadius": 18,
        "padding": {
          "start": 20,
          "top": 18,
          "end": 20,
          "bottom": 18
        }
      },
      "children": [
        {
          "type": "box",
          "modifier": {
            "width": "wrap",
            "background": "#2F9E5B",
            "cornerRadius": 999,
            "padding": {
              "start": 10,
              "top": 3,
              "end": 10,
              "bottom": 3
            }
          },
          "children": [
            {
              "type": "text",
              "text": "NEW SEASON",
              "style": "caption",
              "fontWeight": "bold",
              "color": "#FFFFFF",
              "modifier": {
                "width": "wrap"
              }
            }
          ]
        },
        {
          "type": "text",
          "text": "Curated Store",
          "style": "h2",
          "color": "#FFFFFF"
        },
        {
          "type": "text",
          "text": "Tap any item for full details, photos & ratings",
          "style": "caption",
          "color": "#D3F2DF"
        }
      ]
    },
    {
      "type": "spacer",
      "height": 12
    },
    {
      "type": "repeat",
      "items": "store",
      "as": "p",
      "template": [
        {
          "type": "card",
          "spacing": 8,
          "modifier": {
            "cornerRadius": 16,
            "action": {
              "type": "navigate",
              "screen": "product",
              "params": {
                "id": "{{p.id}}"
              }
            }
          },
          "children": [
            {
              "type": "box",
              "modifier": {
                "width": "wrap",
                "background": "#E9F5EE",
                "cornerRadius": 999,
                "padding": {
                  "start": 10,
                  "top": 3,
                  "end": 10,
                  "bottom": 3
                }
              },
              "children": [
                {
                  "type": "text",
                  "text": "{{p.category}}",
                  "style": "caption",
                  "fontWeight": "medium",
                  "color": "#1B7A43",
                  "modifier": {
                    "width": "wrap"
                  }
                }
              ]
            },
            {
              "type": "text",
              "text": "{{p.title}}",
              "style": "h3",
              "fontWeight": "bold",
              "maxLines": 2,
              "overflow": "ellipsis"
            },
            {
              "type": "row",
              "horizontalArrangement": "spaceBetween",
              "verticalAlignment": "center",
              "modifier": {
                "width": "fill"
              },
              "children": [
                {
                  "type": "text",
                  "text": "${{p.price}}",
                  "fontSize": 20,
                  "fontWeight": "bold",
                  "color": "#1B7A43",
                  "modifier": {
                    "width": "wrap"
                  }
                },
                {
                  "type": "box",
                  "modifier": {
                    "width": "wrap",
                    "background": "#FFF8E1",
                    "cornerRadius": 999,
                    "padding": {
                      "start": 10,
                      "top": 4,
                      "end": 10,
                      "bottom": 4
                    }
                  },
                  "children": [
                    {
                      "type": "text",
                      "text": "★ {{p.rating.rate}}",
                      "style": "caption",
                      "fontWeight": "bold",
                      "color": "#B45309",
                      "modifier": {
                        "width": "wrap"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "spacer",
          "height": 10
        }
      ],
      "empty": [
        {
          "type": "text",
          "text": "No products."
        }
      ]
    }
  ],
  "error": [
    {
      "type": "text",
      "text": "The shop is closed",
      "style": "h3"
    },
    {
      "type": "text",
      "text": "The service did not answer. Try again in a moment."
    },
    {
      "type": "spacer"
    },
    {
      "type": "button",
      "label": "Retry",
      "action": {
        "type": "reload"
      }
    }
  ]
}
