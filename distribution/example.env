# compose-cast server settings. Copy to `.env` next to docker-compose.yml (the install command in
# docs/playbooks/install-server.md downloads it as .env directly) and adjust.

# Server version: `release` = latest release, or pin one, e.g. v0.1.0. `main` = development builds.
COMPOSECAST_VERSION=release

# Your app's data directory: screens/<id>.json, optional brand.json (relative to this file).
COMPOSECAST_DATA_LOCATION=./data

# Port on the host. With HTTPS below, use 127.0.0.1:8080 so only Caddy is public.
COMPOSECAST_PORT=8080

# HTTPS with automatic certificates (Caddy): uncomment both. The domain's DNS record must point to
# this machine, ports 80 and 443 must be open.
# COMPOSE_PROFILES=https
# COMPOSECAST_DOMAIN=app.example.com

# Secrets for data sources: `{{secret.NAME}}` in a data source URL or header reads
# COMPOSECAST_SECRET_NAME. They stay on the server and never reach the app.
# COMPOSECAST_SECRET_WEATHER_KEY=change-me
