# compose-cast server settings. Copy to `.env` next to docker-compose.yml (the install command in
# docs/playbooks/install-server.md downloads it as .env directly) and adjust.

# Server version: `release` = latest release, or pin one, e.g. v0.1.0. `main` = development builds.
COMPOSECAST_VERSION=release

# Your app's data directory: screens/<id>.json, optional brand.json (relative to this file).
COMPOSECAST_DATA_LOCATION=./data

# Port on the host. With HTTPS below, use 127.0.0.1:8080 so only Caddy is public.
COMPOSECAST_PORT=8080

# HTTPS with automatic certificates (Caddy): uncomment both. The domain's DNS record must point to
# this machine, ports 80 and 443 must be open.
# COMPOSE_PROFILES=https
# COMPOSECAST_DOMAIN=app.example.com

# JVM options. By default the heap may grow to 75% of the machine's RAM under load; on a small VPS
# cap it (T-025: the weather app runs steady at ~260 MB RSS with -Xmx128m).
# JAVA_OPTS=-Xmx256m

# Images are never fetched from loopback/private/link-local hosts (SSRF protection).
# Local development only: allow them.
# COMPOSECAST_ALLOW_PRIVATE_IMAGE_HOSTS=true

# Admin panel at https://<your domain>/admin (T-007): screens, publishing, history, settings are
# kept in ./data/compose-cast.db; the files in ./data are imported once at the first start.
# ./data must be writable by UID 1000: sudo chown -R 1000:1000 data
# COMPOSECAST_MODE=admin
# The first admin account, created at the first start in admin mode (required then, ignored later).
# COMPOSECAST_ADMIN_EMAIL=you@example.com
# COMPOSECAST_ADMIN_PASSWORD=change-me-at-least-12-characters
# The login needs HTTPS (COMPOSE_PROFILES=https) or localhost. Testing over plain http only:
# COMPOSECAST_ADMIN_ALLOW_HTTP=true

# Phone preview in the screen editor (admin mode, T-048): an extra container draws each saved
# draft with the app's own player. linux/amd64 hosts (or Docker Desktop on a Mac); ~800 MB RAM.
# Both lines; with HTTPS too: COMPOSE_PROFILES=https,preview
# COMPOSE_PROFILES=preview
# COMPOSECAST_PREVIEW_RENDERER_URL=http://preview-renderer:8090

# Edits in ./data are served within ~3 s (polled every 2 s). Off: read once at startup.
# COMPOSECAST_RELOAD=false

# Secrets for data sources: `{{secret.NAME}}` in a data source URL or header reads
# COMPOSECAST_SECRET_NAME. They stay on the server and never reach the app.
# COMPOSECAST_SECRET_WEATHER_KEY=change-me
