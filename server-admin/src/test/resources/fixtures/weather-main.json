{
  "id": "main",
  "title": "{{params.city}}",
  "params": {
    "lat": {
      "default": "52.23"
    },
    "lon": {
      "default": "21.01"
    },
    "city": {
      "default": "Warsaw"
    }
  },
  "data": {
    "meteo": {
      "url": "https://api.open-meteo.com/v1/forecast?latitude={{params.lat}}&longitude={{params.lon}}&timezone=auto&wind_speed_unit=kmh&current=temperature_2m,apparent_temperature,relative_humidity_2m,wind_speed_10m,weather_code&daily=weather_code,temperature_2m_max,temperature_2m_min&forecast_days=4",
      "cacheSeconds": 600
    }
  },
  "lookups": {
    "wmo": {
      "0": "Clear sky",
      "1": "Mainly clear",
      "2": "Partly cloudy",
      "3": "Overcast",
      "45": "Fog",
      "48": "Rime fog",
      "51": "Light drizzle",
      "53": "Drizzle",
      "55": "Heavy drizzle",
      "56": "Freezing drizzle",
      "57": "Freezing drizzle",
      "61": "Light rain",
      "63": "Rain",
      "65": "Heavy rain",
      "66": "Freezing rain",
      "67": "Freezing rain",
      "71": "Light snow",
      "73": "Snow",
      "75": "Heavy snow",
      "77": "Snow grains",
      "80": "Rain showers",
      "81": "Rain showers",
      "82": "Violent showers",
      "85": "Snow showers",
      "86": "Snow showers",
      "95": "Thunderstorm",
      "96": "Thunderstorm, hail",
      "99": "Thunderstorm, hail",
      "*": "Changing weather"
    },
    "icon": {
      "0": "☀️",
      "1": "🌤️",
      "2": "⛅",
      "3": "☁️",
      "45": "🌫️",
      "48": "🌫️",
      "51": "🌧️",
      "53": "🌧️",
      "55": "🌧️",
      "56": "🌧️",
      "57": "🌧️",
      "61": "🌧️",
      "63": "🌧️",
      "65": "🌧️",
      "66": "🌧️",
      "67": "🌧️",
      "80": "🌧️",
      "81": "🌧️",
      "82": "🌧️",
      "71": "🌨️",
      "73": "🌨️",
      "75": "🌨️",
      "77": "🌨️",
      "85": "🌨️",
      "86": "🌨️",
      "95": "⛈️",
      "96": "⛈️",
      "99": "⛈️",
      "*": "🌡️"
    }
  },
  "components": [
    {
      "type": "column",
      "spacing": 4,
      "horizontalAlignment": "center",
      "modifier": {
        "background": "#FFFFFF",
        "cornerRadius": 16,
        "padding": 24
      },
      "children": [
        {
          "type": "text",
          "text": "{{meteo.current.weather_code | lookup:icon}}",
          "fontSize": 64,
          "modifier": {
            "width": "wrap"
          }
        },
        {
          "type": "text",
          "text": "{{meteo.current.temperature_2m | round}}°",
          "style": "h1",
          "fontSize": 56,
          "modifier": {
            "width": "wrap"
          }
        },
        {
          "type": "text",
          "text": "{{meteo.current.weather_code | lookup:wmo}}",
          "style": "h3",
          "modifier": {
            "width": "wrap"
          }
        },
        {
          "type": "text",
          "text": "Feels like {{meteo.current.apparent_temperature | round}}° · Wind {{meteo.current.wind_speed_10m | round}} km/h · Humidity {{meteo.current.relative_humidity_2m}}%",
          "style": "caption",
          "textAlign": "center"
        }
      ]
    },
    {
      "type": "spacer",
      "height": 16
    },
    {
      "type": "row",
      "spacing": 8,
      "children": [
        {
          "type": "button",
          "label": "Hourly",
          "action": {
            "type": "navigate",
            "screen": "hourly",
            "params": {
              "lat": "{{params.lat}}",
              "lon": "{{params.lon}}",
              "city": "{{params.city}}"
            }
          },
          "modifier": {
            "weight": 1
          }
        },
        {
          "type": "button",
          "label": "7 days",
          "action": {
            "type": "navigate",
            "screen": "daily",
            "params": {
              "lat": "{{params.lat}}",
              "lon": "{{params.lon}}",
              "city": "{{params.city}}"
            }
          },
          "modifier": {
            "weight": 1
          }
        },
        {
          "type": "button",
          "label": "Cities",
          "variant": "outlined",
          "action": {
            "type": "navigate",
            "screen": "cities",
            "params": {}
          },
          "modifier": {
            "weight": 1
          }
        }
      ]
    },
    {
      "type": "spacer",
      "height": 16
    },
    {
      "type": "text",
      "text": "Forecast",
      "style": "caption"
    },
    {
      "type": "spacer",
      "height": 8
    },
    {
      "type": "card",
      "spacing": 12,
      "children": [
        {
          "type": "repeat",
          "items": {
            "day": "meteo.daily.time",
            "code": "meteo.daily.weather_code",
            "max": "meteo.daily.temperature_2m_max",
            "min": "meteo.daily.temperature_2m_min"
          },
          "as": "d",
          "limit": 4,
          "template": [
            {
              "type": "row",
              "verticalAlignment": "center",
              "children": [
                {
                  "type": "text",
                  "text": "{{d.day | date:'EEEE'}}",
                  "modifier": {
                    "weight": 1
                  }
                },
                {
                  "type": "text",
                  "text": "{{d.code | lookup:icon}}",
                  "modifier": {
                    "width": 40
                  }
                },
                {
                  "type": "text",
                  "text": "{{d.max | round}}° / {{d.min | round}}°",
                  "fontWeight": "medium",
                  "textAlign": "end",
                  "modifier": {
                    "width": 96
                  }
                }
              ]
            }
          ],
          "empty": [
            {
              "type": "text",
              "text": "No forecast"
            }
          ]
        }
      ]
    }
  ],
  "error": [
    {
      "type": "text",
      "text": "No weather for {{params.city}}",
      "style": "h3"
    },
    {
      "type": "text",
      "text": "Open-Meteo did not answer. Try again in a moment."
    },
    {
      "type": "spacer"
    },
    {
      "type": "button",
      "label": "Retry",
      "action": {
        "type": "reload"
      }
    }
  ]
}
